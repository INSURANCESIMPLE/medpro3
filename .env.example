# SMTP configuration for advisor form email notifications
# Copy this file to .env and fill in your credentials

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Medicare Professor <your-gmail@gmail.com>

# Optional: override the server port (default: 3000)
# PORT=3000
